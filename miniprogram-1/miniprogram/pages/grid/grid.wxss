.head_box{
  display: flex;
/*justify-content: center;*/
  padding-top: 60rpx;
}
.head_box >image{
  margin-left: 32rpx;
  width: 100rpx;
  height: 100rpx;
}
.head_box >view{
  margin-left: 15rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 100rpx;
}

.sec-container {
  display: flex;
  flex-direction: column;
  align-items: center; /* 整体内容居中 */
  min-height: 80vh; /* 占满屏幕高度 */
  padding: 30rpx;
  box-sizing: border-box; /* 确保padding不影响整体高度 */
}

/* 标题圆角框 */
.sec-title-box {
  background-color: #fff;
  padding: 15rpx 40rpx;
  border-radius: 50rpx;
  margin: 40rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.sec-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

/* 内容容器（ 九宫格+按钮）*/
.content-wrapper {
  flex-grow: 1; /* 占满剩余空间 */
  display: flex;
  flex-direction: column;
  justify-content: center; /* 垂直居中 */
  align-items: center;
  width: 100%;
  margin-top: -100rpx; /* 通过负边距上移九宫格 */
}

/* 放大后的九宫格 */
.grid-container {
  display: flex;
  flex-wrap: wrap;
  width: 450rpx; /* 放大九宫格宽度 */
  height: 450rpx; /* 放大九宫格高度 */
  margin-bottom: 100rpx; /* 与按钮保持距离 */
}

.grid-item {
  width: 150rpx; /* 每个格子放大 */
  height: 150rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  border: 2rpx solid #fff;
  color: #fff;
  font-size: 40rpx; /* 数字放大 */
  font-weight: bold;
}

.green { background-color: #4cd964; }
.red { background-color: #ff3b30; }
.blue { background-color: #007aff; }

.btn-container {
  margin-top: 20rpx;
}

button {
  background-color: #07c160;
  color: #fff;
  padding: 15rpx 40rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
}

/* 底部颜色说明框 */
.legend-box {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 25rpx 40rpx;
  margin: 30rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
  width: 90%;
  max-width: 600rpx;
}

.legend-item {
  font-size: 30rpx;
  color: #333;
  padding: 8rpx 0;
  text-align: center; /* 文字居中 */
}


