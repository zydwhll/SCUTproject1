.head_box{
  display: flex;
/*justify-content: center;*/
  padding-top: 60rpx;
}
.head_box >image{
  margin-left: 32rpx;
  width: 100rpx;
  height: 100rpx;
}
.head_box >view{
  margin-left: 15rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 100rpx;
}

.sec-container {
  display: flex;
  flex-direction: column;
  align-items: center; /* 整体内容居中 */
  min-height: 80vh; /* 占满屏幕高度 */
  padding: 30rpx;
  box-sizing: border-box; /* 确保padding不影响整体高度 */
}

/* 标题圆角框 */
.sec-title-box {
  background-color: #fff;
  padding: 15rpx 40rpx;
  border-radius: 50rpx;
  margin: 40rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.sec-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

/* 内容容器（ 九宫格+按钮）*/
.content-wrapper {
  flex-grow: 1; /* 占满剩余空间 */
  display: flex;
  flex-direction: column;
  justify-content: center; /* 垂直居中 */
  align-items: center;
  width: 100%;
  margin-top: 40rpx; /* 下移单色块 */
}

/* 单一色块压力显示 */
.pressure-block {
  width: 450rpx;
  height: 450rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #fff;
  margin-bottom: 100rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
}

.pressure-value {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
}

.pressure-label {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 500;
  opacity: 0.95;
}

.green { background-color: #4cd964; }
.red { background-color: #ff3b30; }
.blue { background-color: #007aff; }

.btn-container {
  margin-top: 20rpx;
}

button {
  background-color: #07c160;
  color: #fff;
  padding: 15rpx 40rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
}

/* 底部颜色说明框 */
.legend-box {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 25rpx 40rpx;
  margin: 30rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
  width: 90%;
  max-width: 600rpx;
}

.legend-item {
  font-size: 30rpx;
  color: #333;
  padding: 8rpx 0;
  text-align: center; /* 文字居中 */
}


