<!-- 顶部电量条 -->
<battery-bar />

<!-- 自定义计时显示条（顶部） -->
<view class="timer-bar">
  <text class="timer-text">{{timerFormatted}}</text>
</view>

<view class="container">
  <!-- 顶部标题栏 -->
  <view class="head_box">
    <image src="/images/head.jpg" mode=""/>
    <view>{{title}}</view>
  </view>

  <!-- 医院信息卡片 -->
  <view class="hospital-card">
    <view class="hospital-left">
      <image src="/images/GWCMC.png" class="hospital-logo" mode="widthFix"/>
    </view>
    <view class="hospital-right">
      <view class="location-text">
        <image src="/images/map.png" class="location-icon" mode="widthFix" />
        <text>广州市天河区金穗路9号</text>
      </view>
      <view class="blessing-text">广妇儿祝您的孩子</view>
      <view class="blessing-text">早日康复</view>
      <view class="flower-row">
        <image src="/images/flower.png" mode="widthFix" />
        <image src="/images/flower.png" mode="widthFix" />
        <image src="/images/flower.png" mode="widthFix" />
        <image src="/images/flower.png" mode="widthFix" />
        <image src="/images/flower.png" mode="widthFix" />
        <image src="/images/flower.png" mode="widthFix" />
      </view>
    </view>
  </view>
  <!-- 计时按钮（未连接蓝牙文字上方） -->
  <button 
    class="timer-btn {{isTimerRunning ? 'timer-btn-stop' : 'timer-btn-start'}}"
    bindtap="handleTimerClick"
  >
    {{isTimerRunning ? '停止计时' : '开始计时'}}
  </button>

  <!-- 蓝牙开关卡片 -->
  <view class="bluetooth-card">
    <view class="bluetooth-row">
      <view class="bluetooth-left">
        <image src="/images/bluetooth.png" class="bluetooth-icon" mode="widthFix" />
        <text class="bluetooth-status" style="color: {{bluetoothmode ? 'RGB(0,176,80)' : 'RGB(192,0,0)'}}">
          {{bluetoothmode ? '蓝牙连接中' : '未连接蓝牙'}}
        </text>
      </view>
      <switch 
        checked="{{bluetoothmode}}"
        color="#97baff"
        bindchange="bluetoothChange"
      />
    </view>
  </view>

  <!-- 开始扫描按钮（仅蓝牙开关打开时显示） -->
  <view wx:if="{{bluetoothmode}}" style="margin: 30rpx 32rpx;">
    <button bindtap="startScan" class="scan-btn">开始扫描</button>
  </view>

  <!-- 蓝牙设备列表（仅点击开始扫描后显示） -->
  <view wx:if="{{showDeviceList}}" style="margin: 0 32rpx;">
    <bluetooth-comp id="bluetooth-comp" />
  </view>
</view>
