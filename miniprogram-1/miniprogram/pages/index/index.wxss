
page {
  background-color: #f5f5f5;
}

.container {
  padding: 20rpx;
}

.head_box {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}
.head_box > image {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}
.head_box > view {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.hospital-card {
  display: flex;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 32rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}
.hospital-left {
  width: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hospital-logo {
  width: 180rpx;
  height: 180rpx;
}
.hospital-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.location-text {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  margin-left: 30rpx;
}
.location-icon {
  width: 25rpx;
  height: 25rpx;
  margin-right: 10rpx;
}
.blessing-text {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  margin: 5rpx 0;
}
.flower-row {
  display: flex;
  justify-content: center;
  margin-top: 15rpx;
}
.flower-row > image {
  width: 40rpx;
  height: 40rpx;
  margin: 0 5rpx;
}

.bluetooth-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 25rpx 30rpx;
  margin: 0 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}
.bluetooth-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bluetooth-left {
  display: flex;
  align-items: flex-start;
  padding-top: 5rpx;
}
.bluetooth-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
  margin-top: -3rpx;
}
.bluetooth-status {
  font-size: 40rpx;
  font-weight: 500;
  margin-top: -40rpx;
  line-height: 1;
}
.scan-btn {
  background-color: #fff;
  color: #07c160;
  font-size: 28rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx; 
  width: auto; 
  margin: 0 auto;
  border: 1rpx solid #07c160; 
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.15); 
}
.scan-btn::after {
  border: none; 
}
.scan-btn:active {
  background-color: #06b058; 
  box-shadow: 0 1rpx 4rpx rgba(7, 193, 96, 0.2);
}

/* 自定义计时条样式 */
.timer-bar {
  width: 100%;
  height: 44rpx;
  line-height: 44rpx;
  background-color: #f5f5f5;
  text-align: center;
  border-bottom: 1rpx solid #eeeeee;
}

.timer-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 计时按钮样式 */
.timer-btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin: 30rpx auto;
  border-radius: 40rpx;
  font-size: 32rpx;
  border: none;
}

.timer-btn-start {
  background-color: #07c160;
  color: #ffffff;
}

.timer-btn-stop {
  background-color: #f53f3f;
  color: #ffffff;
}
