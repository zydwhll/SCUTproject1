page {
  background-color: #f5f5f5;
  font-size: 32rpx;
}

.container {
  padding: 20rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding: 10rpx 20rpx;
  background-color: #f0f8ff;
  border-radius: 10rpx;
  display: inline-block;
}

.btn {
  background-color: #0088ff;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
  margin-top: 20rpx;
}